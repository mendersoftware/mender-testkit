// renovate.json5 - Mender dependency update configuration for mender-testkit
// See Documentation/dependency-updates.md in mender-qa for the process.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    ":gitSignOff",
    ":rebaseStalePrs"
  ],

  // CODEOWNERS drives reviewer assignment - keep its dependency file entries current.
  "reviewersFromCodeOwners": true,

  // fix(deps): <desc>, per renovate.json5.sample in mender-qa.
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",

  // Fallback window for weeks with no merges; the renovate CI job is the primary trigger.
  "schedule": ["after 10pm on Monday", "before 6am on Tuesday"],

  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,

  // Security PRs bypass the schedule and automerge when CI is green.
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "automerge": true,
    "automergeType": "pr",
    "labels": ["security"]
  },

  "packageRules": [
    {
      // The python dependencies here are floors on what this package imports, not
      // a lockfile: consumers pin exact versions themselves. Raising a floor is a
      // deliberate act -- it says the code now needs something newer -- so it is
      // not something to bump automatically.
      "matchManagers": ["pep621"],
      "enabled": false
    },
    {
      // The pinned mender-server commit. Everything vendored -- testutils and the
      // compose files -- is a copy of it, so a bump can change the topology under
      // every suite that depends on this package. Grouped and labelled so that is
      // obvious in the PR list.
      "matchDepNames": ["https://github.com/mendersoftware/mender-server"],
      "enabled": true,
      "groupName": "mender-server vendored files",
      "commitMessageTopic": "mender-server ref",
      // git-refs tracks main's tip, so a PR arrives whenever anything lands
      // upstream, most touching nothing we vendor.
      // test:vendored-trees already separates the two cases: it passes when the
      // vendored files did not move and fails when they did, because vendor.py
      // regenerates them from the new ref. Automerging on a green check therefore
      // lands the bumps silently and stops on exactly the ones worth
      // reading. This is also why postUpgradeTasks is left unable to run (see
      // below): if it regenerated the trees, every PR would go green and
      // behavioural changes to testutils would merge unreviewed.
      "automerge": true,
      "automergeType": "pr"
    },
    {
      // No submodules here; this package vendors its copies instead.
      "matchManagers": ["git-submodules"],
      "enabled": false
    },
    {
      // The vendored trees are copies, not sources. They pin third-party images
      // (traefik, mongo, nats, redis, seaweedfs) that Renovate would otherwise
      // offer to bump, but vendor.py regenerates these files from the pinned
      // mender-server ref, so such a PR is clobbered on the next re-vendor and
      // fails `vendor.py --check` meanwhile. Bump them upstream instead; they
      // arrive here through _server_ref.py.
      "matchFileNames": ["src/mender_testkit/data/**"],
      "enabled": false
    }
  ],

  "customManagers": [
    {
      // A commit on main, not a release tag, because these suites test unreleased
      // server code: .env pins the backend images to main and the clients are
      // client-main builds, so compose and testutils must come from there too.
      // Fixes the suites need also land on main first and reach a tag only at the
      // next release. Tracking releases instead is workable -- see README for the
      // three files it touches.
      "customType": "regex",
      "managerFilePatterns": ["/^src/mender_testkit/_server_ref\\.py$/"],
      "matchStrings": [
        "MENDER_SERVER_REF = \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "depNameTemplate": "https://github.com/mendersoftware/mender-server",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ],

  // Renovate only rewrites the ref; the vendored trees still hold the old
  // commit's files until vendor.py regenerates them.
  //
  // This block is deliberately inert. It documents what regenerating in-PR would
  // take the bot's global config has to allowlist the command via
  // allowedCommands, and the mendertesting renovate component sets no
  // RENOVATE_ALLOWED_COMMANDS but do not enable it. The ref rule above
  // automerges on a green pipeline, and it is `vendor.py --check` failing that
  // marks a bump as worth reading. Regenerating the trees here would turn every
  // PR green and merge testutils behaviour changes unreviewed.
  //
  // So when a bump does move the vendored files, CI goes red and someone runs
  // `python3 scripts/vendor.py` on the PR branch by hand. That is the intended
  // workflow currently.
  "postUpgradeTasks": {
    "commands": ["python3 scripts/vendor.py"],
    "fileFilters": [
      "src/mender_testkit/testutils/**",
      "src/mender_testkit/data/mender_server/**"
    ],
    "executionMode": "branch"
  }
}
